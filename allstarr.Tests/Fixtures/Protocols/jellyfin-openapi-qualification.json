  "comparisonClasses": {
    "native-relay": "Canonical JSON structure and stable identity fields must match the direct Jellyfin response. Volatile user state and timestamps are compared by type.",
    "constrained-relay": "Every returned native item must retain its direct identity and field types; non-music items, totals, ordering, and injected virtual items may intentionally differ.",
    "synthesized": "Provider and virtual data values intentionally differ. Client-required identifiers, common field types, routable media URLs, artwork, and nested identifier contracts must match native expectations.",
    "transformed": "Declared fields may differ while the documented response schema remains compatible, such as Allstarr server identity and music-only counts.",
    "binary-relay": "Bounded local audio ranges must have matching status, byte count, range headers, media type, and exact bytes. Timing is reported separately.",
    "denied": "Every OpenAPI operation not explicitly listed above must remain HTTP 403 on the public music proxy."
  },
  "clientDtoRequirements": {
    "item": [
      "Id is a non-empty string",
      "Name is a string",
      "Type is a music item type"
    ],
    "namedRelationships": [
      "ArtistItems, AlbumArtists, and GenreItems are optional",
      "When emitted by Allstarr, every entry has non-empty Id and Name strings"
    ],
    "playlistDefinitionRequired": [
      "ItemIds",
      "Shares"
    ],
    "userDataRequired": [
      "Key"
    ],
    "userDataCompatibility": [
      "ItemId is non-empty and equals the containing item Id"
    ],
    "mediaSource": [
      "Id is non-empty",
      "DirectStreamUrl is an Allstarr audio route",
      "Container and capability booleans are present",
      "MediaStreams contains an audio stream with a numeric Index"
    ],
    "artwork": [
      "Advertised external and virtual playlist Primary images resolve to a real image, not the transparent fallback",
      "Reviewed long Primary image routes honor bounded dimensions and JPG, PNG, or WebP output"
    ]
  },
  "intentionalDifferences": [
    {
      "area": "public server info",
      "class": "transformed",
      "difference": "ProductName, LocalAddress, server Id, and operating system describe Allstarr while Version and ServerName reflect the backend connection."
    },
    {
      "area": "music browse and search",
      "class": "constrained-relay",
      "difference": "Non-music entries are removed and enabled provider or virtual entries may be added, so totals and ordering can differ."
    },
    {
      "area": "library views, root, and counts",
      "class": "transformed",
      "difference": "Only the music library is visible and all non-music counts are zero."
    },
    {
      "area": "external and virtual items",
      "class": "synthesized",
      "difference": "Ids, ProviderIds, labels, paths, artwork tags, and media URLs identify provider-backed Allstarr resources rather than Jellyfin database rows."
    },
    {
      "area": "synthesized artwork transforms",
      "class": "synthesized",
      "difference": "Primary image reads and zero-overlay JPG, PNG, and WebP long routes are supported with bounded resizing. Other image kinds, formats, and nonzero overlays are denied; native image routes remain exact relays."
    },
    {
      "area": "virtual playlist relationships",
      "class": "synthesized",
      "difference": "ArtistItems is omitted when no routable artist Id exists; Artists retains display names. Optional relationship objects are never emitted without Id."
    },
    {
      "area": "synthesized playlist writes and sharing",
      "class": "native-relay",
      "difference": "Hybrid Allstarr playlist IDs are resolved within the verified tenant, owner, backend, protocol, and library scope before normal Jellyfin mutations, ACL reads/writes, and instant mixes are relayed to their writable target. Pure virtual and provider-only playlists return a read-only conflict instead of leaking synthetic IDs upstream."
    },
    {
      "area": "playlist deletion",
      "class": "native-relay",
      "difference": "DELETE /Items/{id} is relayed only after the backend identifies the native item as a Playlist. Synthetic playlist IDs and audio, movie, episode, or other library items remain blocked."
    },
    {
      "area": "sequential live comparisons",
      "class": "native-relay",
      "difference": "Playback position, play count, last-played values, request timestamps, and cache validators may change between the direct and proxied request."
    }
  ],
