# Allstarr fresh-install deployment bootstrap.
# Runtime product settings, provider accounts, matching policy, retention, and cache
# policy belong in PostgreSQL and are managed through the WebUI. Do not copy a v2
# environment file over this template; import it through the migration workflow.

# ===== MEDIA SERVER BOOTSTRAP =====
# Backend selection is deployment-owned because it must be known before durable
# settings and user identity can be resolved.
BACKEND_TYPE=Jellyfin

# Jellyfin bootstrap. Leave unused values empty when BACKEND_TYPE=Subsonic.
JELLYFIN_URL=http://host.docker.internal:8096
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=
JELLYFIN_CLIENT_USERNAME=allstarr
JELLYFIN_LIBRARY_ID=

# Navidrome or another Subsonic-compatible server.
SUBSONIC_URL=http://host.docker.internal:4533

# ===== POSTGRESQL AND ENCRYPTION =====
POSTGRES_DB=allstarr
POSTGRES_USER=allstarr
POSTGRES_PASSWORD_FILE=./secrets/postgres-password.txt
ALLSTARR_KEYRING_FILE=./secrets/allstarr-keyring.json
STORAGE_AUTO_MIGRATE=true

# Pin normal deployments to a reviewed release.
ALLSTARR_IMAGE=ghcr.io/sopat712/allstarr:3.1.0-beta.1

# ===== HOST STORAGE =====
# PostgreSQL stores application state. Audio and uploaded provider packages remain
# in explicit host paths; the bounded artwork/media cache uses a named volume.
DOWNLOAD_PATH=./downloads
KEPT_PATH=./kept
APPLE_UPLOAD_PATH=./.apple-provider/incoming

# ===== LISTENERS AND SECURITY BOUNDARIES =====
PROXY_BIND_ADDRESS=0.0.0.0
PROXY_PORT=5274
ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_PORT=5275

# Remote administration requires both an external bind and this explicit opt-in.
# Restrict it further with trusted CIDRs and a firewall or reverse proxy.
ADMIN_BIND_ANY_IP=false
ADMIN_TRUSTED_SUBNETS=
ADMIN_REDACT_SENSITIVE_VALUES=false

# Remote extension installation is a deployment security boundary. Runtime package
# management and permission decisions remain durable PostgreSQL state.
EXTENSIONS_ALLOW_REMOTE_INSTALL=true

# Cross-origin requests are disabled until explicit origins are configured.
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS,HEAD
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,Range,X-Requested-With,X-Emby-Authorization,X-MediaBrowser-Token
CORS_ALLOW_CREDENTIALS=false

# ===== OPTIONAL APPLE DOWNLOAD PROFILE =====
# `./allstarr.sh prepare-apple` selects the architecture for the locally prepared
# wrapper. Provider account/session state is persisted in its dedicated volume.
APPLE_WRAPPER_TARGET_ARCH=x86_64
APPLE_WRAPPER_RUNTIME_PLATFORM=linux/amd64
APPLE_GATEWAY_STOREFRONT=us

# ===== OPTIONAL SPOTIFY LYRICS SIDECAR =====
# This upstream session cookie is a host secret and is never stored in source control.
SPOTIFY_API_SESSION_COOKIE=
SPOTIFY_LYRICS_API_URL=http://spotify-lyrics:8080
