# Optional deployment overrides. Plain docker compose up -d needs no .env file.
# Settings and encrypted accounts are managed in the dashboard.
ALLSTARR_IMAGE=ghcr.io/sopat712/allstarr:3.1.0-beta.1
ALLSTARR_RELEASE_PROFILE=core
ALLSTARR_DATA_PATH=./data

# Music clients use port 5274. The dashboard is local by default.
PROXY_BIND_ADDRESS=0.0.0.0
PROXY_PORT=5274
ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_PORT=5275
ADMIN_BIND_ANY_IP=false
ADMIN_TRUSTED_SUBNETS=
ADMIN_BASE_PATH=

# Optional backend startup defaults. First setup is available in the dashboard.
# A saved connection takes precedence. Leave the unused backend address empty.
BACKEND_TYPE=Jellyfin
JELLYFIN_URL=
SUBSONIC_URL=
