# Allstarr deployment bootstrap.
# Provider accounts, media-server credentials, matching policy, quality, cache,
# schedules, and user preferences belong in SQLite and the WebUI.
# Existing v2 keys may remain during migration; they are intentionally omitted here.

# Required production backend selection.
BACKEND_TYPE=Jellyfin
# Optional comma-separated backend music library IDs; empty selects all.
BACKEND_MUSIC_LIBRARY_IDS=

# Shipped feature boundary. Use development only for unreleased surfaces.
ALLSTARR_RELEASE_PROFILE=core

# Reviewed release image.
ALLSTARR_IMAGE=ghcr.io/sopat712/allstarr:3.1.0-beta.1

# One local data folder: database, key ring, kept music, extensions, and cache.
ALLSTARR_DATA_PATH=./data
APPLE_UPLOAD_PATH=./.apple-provider/incoming

# Published listeners.
PROXY_BIND_ADDRESS=0.0.0.0
PROXY_PORT=5274
ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_PORT=5275

# Explicit host security boundaries.
ADMIN_BIND_ANY_IP=false
ADMIN_TRUSTED_SUBNETS=
# Optional admin mount point; empty keeps the dashboard at /.
ADMIN_BASE_PATH=
# WebUI SSO is opt-in. Public URL must use HTTPS and include ADMIN_BASE_PATH.
ADMIN_OIDC_ENABLED=false
ADMIN_OIDC_AUTHORITY=
ADMIN_OIDC_CLIENT_ID=
ADMIN_OIDC_CLIENT_SECRET=
ADMIN_OIDC_PUBLIC_URL=
ADMIN_OIDC_DISPLAY_NAME=Single sign-on
EXTENSIONS_ALLOW_REMOTE_INSTALL=false
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false

# Optional Spotify lyrics profile secret.
SPOTIFY_API_SESSION_COOKIE=

# Optional canonical metadata source. Keep the public MusicBrainz default until
# your deployment's user agent has been approved by an alternative /ws/2 pool.
MUSICBRAINZ_SOURCE_ID=musicbrainz
MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2
MUSICBRAINZ_RATE_LIMIT_MS=1000
# Leave unset unless the upstream operator explicitly authorizes an alternate identity.
MUSICBRAINZ_AUTHORIZED_USER_AGENT_OVERRIDE=
