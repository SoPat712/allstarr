## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Editors and local files
*.user
*.suo
*.userosscache
*.sln.docstates
*.vs/
# Rider
.idea/
# Visual Studio Code
.vscode/
# Temporary files
*.log

/.env
/.env.before-*
/.allstarr-profiles
/.allstarr-mode
/.apple-provider/
/secrets/
/data/
/allstarr-backups/
/state-transfers/
*.dump
*.sqlite-wal
*.sqlite-shm

# Python build and test output
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Music folders an older install kept next to the checkout
/downloads/

# Kept music files (favorited external tracks)
/kept/

# Cache files (Spotify missing tracks, etc.)
/cache/

# Keep only the exact versioned OpenAPI artifacts. Local feature notes, raw captures, cloned repositories,
# ad-hoc scripts, and credentials under apis/ are intentionally ignored.
apis/*
!apis/specifications/
apis/specifications/*
!apis/specifications/allstarr/
apis/specifications/allstarr/*
!apis/specifications/allstarr/client-v1.json
!apis/specifications/allstarr/client-v2.json
!apis/specifications/jellyfin/
apis/specifications/jellyfin/*
!apis/specifications/jellyfin/openapi-10.11.11.json
!apis/specifications/jellyfin/openapi-12.0.0.json

# Development-only WebUI tooling
/node_modules/
/webui/node_modules/
/webui/.svelte-kit/
/webui/build/
/webui/playwright-report/
/webui/test-results/
/test-results/
