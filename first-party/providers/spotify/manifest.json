{
  "id": "spotify",
  "displayName": "Spotify",
  "version": "1.0.0",
  "sdkVersion": "1",
  "entryPoint": "index.js",
  "capabilities": [
    {
      "kind": "playlist",
      "hooks": ["getUserPlaylists", "getPlaylistTracks", "searchPlaylists"],
      "accountScopes": ["global", "user", "library"]
    }
  ],
  "permissions": [
    { "kind": "network", "value": "https://open.spotify.com/", "required": true },
    { "kind": "network", "value": "https://api.spotify.com/", "required": true },
    { "kind": "secret", "value": "sessionCookie", "required": true }
  ]
}
