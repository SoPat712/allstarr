{
  "openapi": "3.1.1",
  "info": {
    "title": "Allstarr Client API",
    "version": "1"
  },
  "paths": {
    "/allstarr/v1/capabilities": {
      "get": {
        "tags": [
          "Capabilities"
        ],
        "operationId": "getCapabilities",
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientCapabilities"
                }
              }
            }
          }
        }
      }
    },
    "/allstarr/v1/items/details": {
      "post": {
        "tags": [
          "ItemDetails"
        ],
        "operationId": "getItemDetails",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ItemDetailsRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ItemDetailsRequest"
              }
            },
            "application/*\u002Bjson": {
              "schema": {
                "$ref": "#/components/schemas/ItemDetailsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemDetailsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/allstarr/v1/providers/{providerId}/icon": {
      "get": {
        "tags": [
          "ProviderIcons"
        ],
        "operationId": "getProviderIcon",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "image/svg\u002Bxml": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/webp": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/x-icon": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "304": {
            "description": "Not Modified"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ClientApiError": {
        "required": [
          "code",
          "error"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        }
      },
      "ClientCapabilities": {
        "required": [
          "serverVersion",
          "apiVersion",
          "features"
        ],
        "type": "object",
        "properties": {
          "serverVersion": {
            "type": "string"
          },
          "apiVersion": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "features": {
            "$ref": "#/components/schemas/ClientFeatures"
          }
        }
      },
      "ClientFeatures": {
        "type": "object",
        "properties": {
          "titleMarkers": {
            "type": "boolean"
          },
          "itemDetails": {
            "type": "boolean"
          },
          "playback": {
            "type": "boolean"
          },
          "lyricsRich": {
            "type": "boolean"
          },
          "lyricsSources": {
            "type": "boolean"
          },
          "fixesMatch": {
            "type": "boolean"
          },
          "reports": {
            "type": "boolean"
          },
          "mixes": {
            "type": "boolean"
          },
          "releases": {
            "type": "boolean"
          },
          "follow": {
            "type": "boolean"
          },
          "lyricsSearch": {
            "type": "boolean"
          },
          "events": {
            "type": "boolean"
          }
        }
      },
      "ItemDetails": {
        "required": [
          "id",
          "isExternal",
          "canonicalRecordingId",
          "isrc",
          "provider",
          "audio",
          "explicit",
          "saved",
          "keep",
          "match",
          "lyrics"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "isExternal": {
            "type": "boolean"
          },
          "canonicalRecordingId": {
            "type": [
              "null",
              "string"
            ]
          },
          "isrc": {
            "type": [
              "null",
              "string"
            ]
          },
          "provider": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ItemDetailsProvider"
              }
            ]
          },
          "audio": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ItemDetailsAudio"
              }
            ]
          },
          "explicit": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "saved": {
            "type": "boolean"
          },
          "keep": {
            "$ref": "#/components/schemas/ItemDetailsKeep"
          },
          "match": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ItemDetailsMatch"
              }
            ]
          },
          "lyrics": {
            "$ref": "#/components/schemas/ItemDetailsLyrics"
          }
        }
      },
      "ItemDetailsAudio": {
        "required": [
          "codec",
          "bitDepth",
          "sampleRate",
          "bitrate"
        ],
        "type": "object",
        "properties": {
          "codec": {
            "type": [
              "null",
              "string"
            ]
          },
          "bitDepth": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "sampleRate": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "bitrate": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "ItemDetailsKeep": {
        "required": [
          "state",
          "progress"
        ],
        "type": "object",
        "properties": {
          "state": {
            "type": "string"
          },
          "progress": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?(?:[eE][\u002B-]?\\d\u002B)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "ItemDetailsLyrics": {
        "required": [
          "available",
          "format",
          "source"
        ],
        "type": "object",
        "properties": {
          "available": {
            "type": "boolean"
          },
          "format": {
            "type": [
              "null",
              "string"
            ]
          },
          "source": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ItemDetailsMatch": {
        "required": [
          "state",
          "confidence",
          "authority"
        ],
        "type": "object",
        "properties": {
          "state": {
            "type": "string"
          },
          "confidence": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?(?:[eE][\u002B-]?\\d\u002B)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "authority": {
            "type": "string"
          }
        }
      },
      "ItemDetailsProvider": {
        "required": [
          "id",
          "name",
          "iconUrl"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "iconUrl": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ItemDetailsRequest": {
        "required": [
          "ids"
        ],
        "type": "object",
        "properties": {
          "ids": {
            "maxItems": 100,
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ItemDetailsResponse": {
        "required": [
          "items",
          "missing"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemDetails"
            }
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Capabilities"
    },
    {
      "name": "ItemDetails"
    },
    {
      "name": "ProviderIcons"
    }
  ]
}
