            "type": [
              "null",
              "string"
            ]
          },
          "album": {
            "type": [
              "null",
              "string"
            ]
          },
          "durationMs": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int64"
          },
          "isrc": {
            "type": [
              "null",
              "string"
            ]
          },
          "provider": {
            "$ref": "#/components/schemas/ItemDetailsProvider"
          },
          "isExternal": {
            "type": "boolean"
          },
          "confidence": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ItemDetailsProvider": {
        "required": [
          "id",
          "name",
          "iconUrl"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "iconUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "glyphUrl": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RichLyrics": {
        "required": [
