{
  "openapi": "3.1.1",
  "info": {
    "title": "Allstarr Client API",
    "version": "2"
  },
  "paths": {
    "/allstarr/v2/artists/{libraryArtistId}/links": {
      "get": {
        "tags": [
          "ArtistLinks"
        ],
        "description": "The service artists shown as this library artist, tied by matched songs or by a person\u0027s answer, and the ones someone said are a different act. Ids may be v2 artist ids or the older media server and \u0060ext-\u0060 artist ids.",
        "operationId": "getArtistLinks",
        "parameters": [
          {
            "name": "libraryArtistId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2ArtistLinksResponse"
                }
              }
            }
          }
        }
      }
    },
    "/allstarr/v2/artists/{libraryArtistId}/links/{serviceArtistId}": {
      "put": {
        "tags": [
          "ArtistLinks"
        ],
        "description": "Says whether a service artist is the same artist as this library artist. An administrator\u0027s answer covers the household; a listener\u0027s covers only them and wins over the household\u0027s for them. Search and artist pages follow at once. Ids may be v2 artist ids or the older media server and \u0060ext-\u0060 artist ids.",
        "operationId": "setArtistLink",
        "parameters": [
          {
            "name": "libraryArtistId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "serviceArtistId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/V2ArtistLinkRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/V2ArtistLinkRequest"
              }
            },
            "application/*\u002Bjson": {
              "schema": {
                "$ref": "#/components/schemas/V2ArtistLinkRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2ArtistLinksResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "ArtistLinks"
        ],
        "description": "Takes back this person\u0027s answer, so matched songs decide again. A listener cannot take back the household\u0027s answer (403); they can mark it as not the same for themselves instead. Ids may be v2 artist ids or the older media server and \u0060ext-\u0060 artist ids.",
        "operationId": "clearArtistLink",
        "parameters": [
          {
            "name": "libraryArtistId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "serviceArtistId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2ArtistLinksResponse"
                }
              }
            }
          }
        }
      }
    },
    "/allstarr/v2/batch": {
      "post": {
        "tags": [
          "Batch"
        ],
        "description": "Runs up to 20 v2 reads in one round trip and returns each one\u0027s status and body by its \u0060id\u0060. Only v2 GET routes can be batched. One failing read never fails the others.",
        "operationId": "batch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/V2BatchRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/V2BatchRequest"
              }
            },
            "application/*\u002Bjson": {
              "schema": {
                "$ref": "#/components/schemas/V2BatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2BatchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/allstarr/v2/tracks": {
      "get": {
        "tags": [
          "Tracks"
        ],
        "description": "Reads up to 100 tracks in the order asked. Any id spelling is accepted: a track id, a library item id or an \u0060ext-\u0060 service id. Two spellings of one song return it once, with both in \u0060aliases\u0060. Ids that are unknown or hidden for this listener are listed in \u0060missing\u0060.",
        "operationId": "getTracks",
        "parameters": [
          {
            "name": "ids",
            "in": "query",
            "description": "Comma-separated ids, at most 100.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "include",
            "in": "query",
            "description": "Comma-separated extras. \u0060album\u0060 adds an \u0060albums\u0060 map keyed by album id.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2TracksResponse"
                }
              }
            }
          }
        }
      }
    },
    "/allstarr/v2/tracks/{id}": {
      "get": {
        "tags": [
          "Tracks"
        ],
        "description": "Reads one track by any id spelling, with any requested views.",
        "operationId": "getTrack",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "include",
            "in": "query",
            "description": "Comma-separated extras. \u0060album\u0060 adds an \u0060albums\u0060 map keyed by album id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "views",
            "in": "query",
            "description": "Comma-separated views: \u0060lyrics\u0060, \u0060lyricsSources\u0060, \u0060match\u0060. \u0060viewStatus\u0060 says how each one went.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientApiError"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2TrackResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ClientApiError": {
        "required": [
          "code",
          "error"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        }
      },
      "ClientItemMatch": {
        "required": [
          "state",
          "confidence",
          "authority",
          "current",
          "candidates",
          "revision"
        ],
        "type": "object",
        "properties": {
          "state": {
            "type": "string"
          },
          "confidence": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "authority": {
            "type": "string"
          },
          "current": {
            "type": [
              "null",
              "object"
            ],
            "anyOf": [
              {
                "$ref": "#/components/schemas/ClientMatchCandidate"
              },
              {
                "type": "null"
              }
            ]
          },
          "candidates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClientMatchCandidate"
            }
          },
          "revision": {
            "type": "string"
          }
        }
      },
      "ClientLyricsChosen": {
        "required": [
          "sourceId",
          "layer"
        ],
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "layer": {
            "type": "string"
          }
        }
      },
      "ClientLyricsRevision": {
        "type": "object",
        "properties": {
          "personal": {
            "type": [
              "null",
              "object"
            ],
            "anyOf": [
              {
                "$ref": "#/components/schemas/ClientLyricsStamp"
              },
              {
                "type": "null"
              }
            ]
          },
          "household": {
            "type": [
              "null",
              "object"
            ],
            "anyOf": [
              {
                "$ref": "#/components/schemas/ClientLyricsStamp"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "ClientLyricsSource": {
        "required": [
          "sourceId",
          "format",
          "preview",
          "providerId",
          "providerName",
          "title",
          "artist",
          "album",
          "durationMs"
        ],
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "format": {
            "type": [
              "null",
              "string"
            ]
          },
          "preview": {
            "type": [
              "null",
              "string"
            ]
          },
          "providerId": {
            "type": "string"
          },
          "providerName": {
            "type": "string"
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "artist": {
            "type": [
              "null",
              "string"
            ]
          },
          "album": {
            "type": [
              "null",
              "string"
            ]
          },
          "durationMs": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int64"
          },
          "state": {
            "type": "string"
          },
          "score": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "rank": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "reasons": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "lyrics": {
            "type": [
              "null",
              "object"
            ],
            "anyOf": [
              {
                "$ref": "#/components/schemas/RichLyrics"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "ClientLyricsSources": {
        "required": [
          "sources",
          "chosen",
          "revision"
        ],
        "type": "object",
        "properties": {
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClientLyricsSource"
            }
          },
          "chosen": {
            "type": [
              "null",
              "object"
            ],
            "anyOf": [
              {
                "$ref": "#/components/schemas/ClientLyricsChosen"
              },
              {
                "type": "null"
              }
            ]
          },
          "revision": {
            "$ref": "#/components/schemas/ClientLyricsRevision"
          }
        }
      },
      "ClientLyricsStamp": {
        "required": [
