        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ClientMatchCandidate": {
        "required": [
          "candidateId",
          "title",
          "artist",
          "album",
          "durationMs",
          "isrc",
