          "endMs",
          "text",
          "part",
          "words"
        ],
        "type": "object",
        "properties": {
          "startMs": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int64"
          },
          "endMs": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int64"
          },
          "text": {
            "type": "string"
          },
          "part": {
            "type": "string"
          },
          "words": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RichLyricsWord"
            }
          },
          "voice": {
            "type": [
              "null",
              "string"
            ]
          },
          "singer": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RichLyricsSource": {
        "required": [
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "RichLyricsWord": {
        "required": [
          "startMs",
          "endMs",
          "text"
        ],
        "type": "object",
        "properties": {
          "startMs": {
            "type": "integer",
            "format": "int64"
          },
          "endMs": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int64"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "V2AlbumSummary": {
        "required": [
          "id",
          "title",
          "artists",
          "year",
          "isExternal",
          "artwork"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "artists": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/V2Ref"
            }
          },
          "year": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "isExternal": {
            "type": "boolean"
          },
          "artwork": {
            "type": [
              "null",
              "object"
            ],
            "anyOf": [
              {
                "$ref": "#/components/schemas/V2Artwork"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "V2ArtistLink": {
        "required": [
          "id",
          "aliases",
          "source",
          "sourceName",
          "by",
          "scope"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            },
