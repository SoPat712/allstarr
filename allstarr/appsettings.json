{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient.Default.LogicalHandler": "Warning",
      "System.Net.Http.HttpClient.Default.ClientHandler": "Warning",
      "System.Net.Http.HttpClient.JellyfinBackend.LogicalHandler": "Warning",
      "System.Net.Http.HttpClient.JellyfinBackend.ClientHandler": "Warning"
    }
  },
  "Debug": {
    "LogAllRequests": false,
    "RedactSensitiveRequestValues": true
  },
  "Backend": {
    "Type": "Jellyfin"
  },
  "StartupValidation": {
    "ProbeOptionalProviders": false
  },
  "Storage": {
    "Provider": "Postgres",
    "ConnectionString": "Host=localhost;Port=5432;Database=allstarr;Username=allstarr",
    "PasswordFile": "",
    "AutoMigrate": true,
    "CommandTimeoutSeconds": 30,
    "ConnectionRetryCount": 3,
    "RuntimeProbeIntervalSeconds": 5,
    "RuntimeProbeTimeoutSeconds": 5,
    "EnforceMutationGuard": true,
    "BackupDirectory": "/app/state/backups"
  },
  "Secrets": {
    "KeyRingPath": "/run/secrets/allstarr-keyring.json",
    "MaxSecretBytes": 65536
  },
  "Identity": {
    "Mode": "Hybrid",
    "DefaultTenantId": "018f1f6e-7db7-7ab0-8b32-f26f12ff6d6a",
    "DefaultTenantSlug": "default",
    "DefaultTenantName": "Allstarr",
    "SingleUserId": "018f1f6e-8e9c-77f5-9a79-3d8a494d60cd",
    "BackendInstanceId": "primary"
  },
  "ProviderAccounts": {
    "ManagementMode": "Hybrid"
  },
  "ProviderPolicy": {
    "AllowGlobalAccounts": true,
    "AllowGlobalPersonalAccounts": false
  },
  "Providers": {
    "MetadataFanoutConcurrency": 4
  },
  "Matching": {
    "LocalPreferencePercent": 7,
    "ExtensionPenaltyPercent": 3
  },
  "Operations": {
    "EventLog": {
      "RetentionDays": 30,
      "MaximumRows": 250000,
      "CleanupBatchSize": 1000,
      "CleanupIntervalMinutes": 360
    }
  },
  "Jobs": {
    "DefaultMaxAttempts": 5,
    "DefaultMaxDeferrals": 96,
    "MaxOutboxAttempts": 20,
    "LeaseSeconds": 60,
    "PollIntervalMilliseconds": 1000,
    "MaxPayloadBytes": 262144
  },
  "ProviderHealth": {
    "FailureThreshold": 3,
    "CircuitOpenSeconds": 60,
    "SampleTtlSeconds": 300
  },
  "Readiness": {
    "RequireSecretKeyRing": false,
    "MinimumFreeBytes": 16777216,
    "RequiredDirectories": []
  },
  "Sidecars": {
    "ProbeIntervalSeconds": 900,
    "ProbeJitterSeconds": 60,
    "ProbeTimeoutSeconds": 5,
    "MaxProbesPerCycle": 16,
    "Targets": []
  },
  "Admin": {
    "BindAnyIp": false,
    "TrustedSubnets": ""
  },
  "Extensions": {
    "AllowRemoteInstall": false
  },
  "FavoriteActions": {
    "AddToVirtualLiked": true,
    "MatchLocalLibrary": false,
    "AutoDownload": false,
    "EnrichMetadata": false,
    "PlaceManagedFile": false,
    "RefreshBackendLibrary": false,
    "Placement": {
      "RootId": "00000000-0000-0000-0000-000000000000",
      "RootPath": "",
      "PathTemplate": "{albumArtist}/{album}/{track} - {title}{extension}"
    }
  },
  "Downloads": {
    "Workspace": {
      "RootPath": "/app/cache/download-workspaces"
    }
  },
  "Cors": {
    "AllowedOrigins": "",
    "AllowedMethods": "GET,POST,PUT,PATCH,DELETE,OPTIONS,HEAD",
    "AllowedHeaders": "Accept,Authorization,Content-Type,Range,X-Requested-With,X-Emby-Authorization,X-MediaBrowser-Token",
    "AllowCredentials": false
  },
  "Subsonic": {
    "Url": "http://localhost:4533",
    "MusicService": "None",
    "ExplicitFilter": "All",
    "DownloadMode": "Track",
    "StorageMode": "Permanent",
    "CacheDurationHours": 1,
    "EnableExternalPlaylists": false
  },
  "Jellyfin": {
    "Url": "http://localhost:8096",
    "ApiKey": "",
    "UserId": "",
    "LibraryId": "",
    "MusicService": "None",
    "ExplicitFilter": "All",
    "DownloadMode": "Track",
    "StorageMode": "Permanent",
    "CacheDurationHours": 1,
    "EnableExternalPlaylists": false
  },
  "Library": {
    "DownloadPath": "./downloads"
  },
  "Qobuz": {
    "UserAuthToken": "",
    "UserId": "",
    "Quality": "FLAC_24_HIGH",
    "MinRequestIntervalMs": 200
  },
  "Deezer": {
    "Arl": "",
    "ArlFallback": "",
    "Quality": "FLAC",
    "MinRequestIntervalMs": 200
  },
  "SquidWTF": {
    "Quality": "FLAC",
    "MinRequestIntervalMs": 200
  },
  "Cache": {
    "SearchResultsMinutes": 1,
    "PlaylistImagesHours": 168,
    "LyricsDays": 14,
    "GenreDays": 30,
    "MetadataDays": 7,
    "OdesliLookupDays": 60,
    "ProxyImagesDays": 14,
    "TranscodeCacheMinutes": 60
  },
  "SpotifyImport": {
    "Enabled": false,
    "SyncStartHour": 16,
    "SyncStartMinute": 15,
    "SyncWindowHours": 2,
    "MatchingIntervalHours": 24,
    "Playlists": []
  },
  "SpotifyApi": {
    "Enabled": false,
    "SessionCookie": "",
    "LyricsApiUrl": "",
    "CacheDurationMinutes": 60,
    "RateLimitDelayMs": 100,
    "PreferIsrcMatching": true
  },
  "MusicBrainz": {
    "Enabled": true,
    "Username": "",
    "Password": "",
    "BaseUrl": "https://musicbrainz.org/ws/2",
    "RateLimitMs": 1000
  }
}
